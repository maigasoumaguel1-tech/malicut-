+function loadSettings(){const t=localStorage.getItem('malicut_theme'),a=localStorage.getItem('malicut_autoplay'),i=localStorage.getItem('malicut_interface_style'),c=localStorage.getItem('malicut_community_loading');if(t)$('theme').value=t;if(a)$('autoplay').value=a;if(i)$('interfaceStyle').value=i;if(c)$('communityLoading').value=c}
+function resetPreferences(){['malicut_theme','malicut_autoplay','malicut_interface_style','malicut_community_loading'].forEach(k=>localStorage.removeItem(k));loadSettings();$('settingsMsg').textContent='Préférences réinitialisées. Le compte et les publications sont conservés.'}
+function clearLocalPreferences(){['malicut_theme','malicut_autoplay','malicut_interface_style','malicut_community_loading'].forEach(k=>localStorage.removeItem(k));loadSettings();$('settingsMsg').textContent='Préférences locales nettoyées.'}
